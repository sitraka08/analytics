# Copy this file to .env.local and fill in the values.

# Supabase (local: run `pnpm db:start` and copy the values it prints)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, used by /api/collect. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Show the "Continue with Google" button (the provider itself is configured in Supabase)
NEXT_PUBLIC_GOOGLE_ENABLED=

# Secret used to derive the daily visitor salt (openssl rand -base64 32). Never expose it.
VISITOR_SALT_SECRET=
