# Copy this file to .env.local and fill in the values.

# Postgres. Local: `pnpm db:start` (Docker). Production: Neon pooled connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/analytics

# Better Auth: secret used to sign sessions (openssl rand -base64 32) and the public URL of the app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public URL of the app (used in the tracking snippet)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in: show the button and provide the OAuth credentials (callback: <BETTER_AUTH_URL>/api/auth/callback/google)
NEXT_PUBLIC_GOOGLE_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional emails (verification, password reset). Without a key, links are printed in the server console.
RESEND_API_KEY=
EMAIL_FROM=

# Secret used to derive the daily visitor salt (openssl rand -base64 32). Never expose it.
VISITOR_SALT_SECRET=
