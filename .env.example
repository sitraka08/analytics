# Copier ce fichier en .env.local et remplir les valeurs.

# Postgres local (Docker) en dev, URL poolée Neon en production
DATABASE_URL=postgres://user:password@localhost:5433/analytics

# Better Auth : secret aléatoire (openssl rand -base64 32) et URL publique de l'app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com > Identifiants)
# URI de redirection autorisée : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (resend.com). Sans clé en dev, les liens des e-mails s'affichent dans le terminal.
RESEND_API_KEY=
# Expéditeur : domaine vérifié sur Resend, ou onboarding@resend.dev pour tester vers votre propre adresse
EMAIL_FROM="Statly <onboarding@resend.dev>"
