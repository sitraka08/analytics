# Copy this file to .env.local and fill in the values.

# Local Postgres (Docker) in dev, pooled Neon URL in production
DATABASE_URL=postgres://user:password@localhost:5433/analytics

# Better Auth: random secret (openssl rand -base64 32) and public URL of the app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Set to "true" to require a verified email before sign-in (needs a working email sender)
REQUIRE_EMAIL_VERIFICATION=

# Google OAuth (console.cloud.google.com > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (resend.com). Without a key in dev, email links are printed in the terminal.
RESEND_API_KEY=
# Sender: a domain verified on Resend, or onboarding@resend.dev to test with your own address
EMAIL_FROM="Statly <onboarding@resend.dev>"

# Secret used to derive the daily visitor salt (openssl rand -base64 32). Never expose it.
VISITOR_SALT_SECRET=
